[Unit]
Description=Google Drive → HDD sync (akn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/gdrive-sync
ExecStart=/home/%i/gdrive-sync/venv/bin/python sync.py
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
